# Project Hades — Environment Configuration

# OTEL
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development

# Service URLs (used by services to call each other)
AUTH_SERVICE_URL=http://auth:8001
AI_SERVICE_URL=http://ai-service:8002
DB_SERVICE_URL=http://db-service:8003
CACHE_SERVICE_URL=http://cache-service:8004
REDIS_URL=redis://redis:6379

# Auth
VALID_API_KEYS=hades-key-001,hades-key-002,hades-key-003
VALID_TOKENS=hades-token-001,hades-token-002,hades-token-003

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=hades
GF_USERS_ALLOW_SIGN_UP=false
